[
  {
    "id": "brookings_events",
    "firm_name": "Brookings Institution",
    "firm_type": "Think Tank",
    "url": "https://www.brookings.edu/events/",
    "adapter_type": "html_list",
    "selectors_json": {
      "item_selector": ".event-card, .card, article",
      "title_selector": "h3 a, h4 a, a",
      "link_selector": "a",
      "date_selector": ".date, time"
    },
    "default_tags_json": ["Macro", "Policy"],
    "active": 1
  },
  {
    "id": "cepr_events",
    "firm_name": "CEPR",
    "firm_type": "Research Network",
    "url": "https://cepr.org/events",
    "adapter_type": "html_list",
    "selectors_json": {
      "item_selector": "article.c-card--event",
      "title_selector": "a.c-card__image-wrapper",
      "link_selector": "a.c-card__image-wrapper",
      "date_selector": "time, .c-card__date"
    },
    "title_extraction": {
      "mode": "attribute",
      "title_attr": "title"
    },
    "postprocess_rules": {
      "reject_date_only_titles": true,
      "min_title_length": 15,
      "title_regex_replace": [
        {"pattern": "\\s*-\\s*Seminar\\s*\\d+\\s*-\\s*", "repl": " - "}
      ]
    },
    "default_tags_json": ["Macro", "Research"],
    "active": 1
  },
  {
    "id": "csis_events",
    "firm_name": "CSIS",
    "firm_type": "Think Tank",
