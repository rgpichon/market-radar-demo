    "adapter_type": "html_list",
    "selectors_json": {
      "item_selector": ".event-item, article, .card",
      "title_selector": "h3 a, h4 a, a",
      "link_selector": "a",
      "date_selector": ".date, time"
    },
    "default_tags_json": ["Geopolitics", "Policy"],
    "active": 1
  },
  {
    "id": "bruegel_events",
