  {
    "id": "lse_events",
    "firm_name": "LSE",
    "firm_type": "Academic",
    "url": "https://www.lse.ac.uk/Events",
    "adapter_type": "html_list",
    "selectors_json": {
      "item_selector": ".ui-card, .uiCardstyled__UICardStyled-sc-69biw8-0",
      "title_selector": ".card__title a, .card__title, a",
      "link_selector": "a",
      "date_selector": ".date, time"
    },
    "postprocess_rules": {
      "min_title_length": 12,
      "reject_title_contains": [
        "course", "programme", "pre-event dining", "dining offer",
        "campus tour", "accommodation", "student life", "apply now",
        "how to apply", "scholarships", "funding", "fees",
        "online courses", "art on campus", "lse player", "green impact"
      ],
      "reject_url_contains": [
        "/courses", "/study", "/programmes", "/accommodation",
        "/dining", "/offer", "/student", "/apply", "/fees",
        "/scholarships", "/funding", "/admissions"
      ],
      "require_url_contains_one_of": [
        "/events/", "/event/", "/public-event", "/lecture", "/seminar"
      ]
    },
    "default_tags_json": ["Research", "Academic"],
    "active": 1
  },
